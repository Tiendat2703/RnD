# Sidekick — server-side credentials only.
# Copy to .env.local if that file does not already exist.
# Never add these keys to browser code or NEXT_PUBLIC_/VITE_ variables.

# OpenAI project application key for Agents API and GPT-Live.
# Agents API requires api.agents.read, api.agents.write, api.responses.write.
# GPT-Live access must also be verified with this project/key.
OPENAI_API_KEY=

# Exa dashboard API key.
EXA_API_KEY=

# Ambiguous AI bearer API key for the intended workspace/agent identity.
# Requires access to read, create, and update workspace documents.
AMBIGUOUS_API_KEY=

# Optional: defaults shown here. Keep the app bound to localhost.
# Agents default to gpt-5.6-luna with low reasoning and Fast processing.
# OPENAI_AGENT_MODEL=gpt-5.6-luna
# PORT=3000
# SIDEKICK_DATA_DIR=.sidekick

# LiveKit agent development. Cloud injects these credentials when deployed.
LIVEKIT_URL=wss://demo-m6ejx9q0.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=sidekick

# Layer 1 -> layer 2 transcript handoff. Leave unset for transcript-only mode.
# The worker sends POST {SIDEKICK_BACKEND_URL}/v1/livekit/transcripts.
SIDEKICK_BACKEND_URL=
# Optional for the unauthenticated MVP.
SIDEKICK_BACKEND_TOKEN=
# SIDEKICK_BACKEND_TIMEOUT_MS=5000
# SIDEKICK_BACKEND_MAX_ATTEMPTS=4
# SIDEKICK_BACKEND_CONCURRENCY=4
# SIDEKICK_BACKEND_MAX_QUEUE=512
